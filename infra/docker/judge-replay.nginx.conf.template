#  The judge-replay server.  Read-only, GET-only, and nothing behind it.
#
#  There is no `proxy_pass` in this file and there must never be one: the whole
#  point of the hosted build is that a viewer's browser can reach the tracked
#  replay artifacts and cannot reach anything else. `/api/` is refused
#  explicitly rather than left to fall through to the SPA fallback, so a stale
#  client asking for a mutation endpoint gets an honest 404 instead of an
#  HTML page with a 200 on it.
#
#  ${PORT} is substituted by the image's entrypoint before nginx starts, which
#  is how Cloud Run's assigned port reaches the listener.

server {
    listen       ${PORT};
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    #  Do not advertise the version to anyone scanning.
    server_tokens off;

    #  This build has no mutation. Say so at the listener, not only in the
    #  application: anything that is not a read is refused before it is routed.
    limit_except GET HEAD {
        deny all;
    }

    #  The page is self-contained: its own scripts and styles, its own JSON,
    #  and no third party. Nothing here needs to be framed or to frame anyone.
    add_header X-Content-Type-Options  "nosniff"        always;
    add_header X-Frame-Options         "DENY"           always;
    add_header Referrer-Policy         "no-referrer"    always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;

    #  Hashed asset names, so they may be cached hard.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
    }

    #  The replay artifacts are the evidence on the page. They are small and
    #  they change when the proof record changes, so they are revalidated
    #  rather than pinned.
    location /cases/ {
        add_header Cache-Control "no-cache" always;
        default_type application/json;
    }

    #  No API is served here. A request for one is a 404, never a fallback.
    location /api/ {
        return 404;
    }

    #  Single page application: unknown paths render the app, not a listing.
    autoindex off;
    location / {
        try_files $uri $uri/ /index.html;
    }
}
