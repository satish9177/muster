# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
.specvenv-z3/

# Environment / secrets
.env
.env.*
!.env.example

# Private keys, wherever somebody puts one.  30-secrets.sh --generate writes
# outside the tree on purpose; this is the guard for the time it does not.
*.pem
*.p12
*.key

# Deployment verification output.  It records outcomes rather than object
# bodies -- and a directory named for evidence, beside a repository, is not
# one to leave trackable on the strength of that.
infra/evidence/

# Deterministic demo output.  ``demo/procurement_case.py`` and the hero run
# both take an output directory rather than writing to a fixed one; the copies
# that ship are the ones committed under ``packages/muster-ui/public/cases/``,
# so a regenerated tree here is a build product and not a second source.
demo/output/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary files
tmp/
.tmp-*/
*.tmp

# Build artifacts
build/
dist/
*.egg-info/

# Hypothesis example database (created by the property tests)
.hypothesis/
